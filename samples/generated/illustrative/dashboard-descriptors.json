            "value_format": "status"
          },
          {
            "field": "state.metric",
            "label": "Metric",
            "value_format": "number"
          },
          {
            "field": "state.route_type",
            "label": "Route type",
            "value_format": "number"
          }
        ],
        "max_rows": 20,
        "resource_kinds": [
          "ISIS_ADJACENCY",
          "EVPN_ROUTE",
          "MPLS_PREFIX_SID",
          "SRV6_LOCATOR"
        ],
        "sort_direction": "ascending",
        "sort_field": "kind",
        "table_id": "protocol-objects",
        "title": "Protocol objects"
      }
    ],
    "title": "Protocol state"
  },
