[
  {
    "collapsible": true,
    "dashboard_id": "forwarding-health",
    "default_expanded": true,
    "default_open": true,
    "description": "Forwarding Groups, ETGs, ETEs and DTEs at the selected time.",
    "movable": true,
    "plugin_defined": true,
    "statistics": [
      {
        "aggregation": "count",
        "label": "Forwarding objects",
        "resource_kinds": [
          "FORWARDING_GROUP",
          "ETG",
          "ETE",
          "DTE"
        ],
        "statistic_id": "forwarding-objects"
      },
      {
        "aggregation": "count",
        "filters": [
          {
            "field": "status",
            "operator": "in",
            "value": [
              "active",
              "standby",
              "selected-pending"
            ]
          }
        ],
        "label": "Usable ETEs",
        "resource_kinds": [
          "ETE"
        ],
        "statistic_id": "eligible-entries"
      },
      {
        "aggregation": "count",
        "filters": [
          {
            "field": "status_class",
            "operator": "eq",
            "value": "error"
          }
        ],
        "label": "Error states",
        "resource_kinds": [
          "FORWARDING_GROUP",
          "ETG",
          "ETE",
          "DTE"
        ],
        "statistic_id": "forwarding-errors"
      }
    ],
    "tables": [
      {
        "columns": [
          {
            "field": "label",
            "label": "Resource",
            "value_format": "resource"
          },
          {
            "field": "kind",
            "label": "Type",
            "value_format": "text"
          },
          {
            "field": "status",
            "label": "Status",
            "value_format": "status"
          },
          {
            "field": "state.path",
            "label": "Path",
            "value_format": "text"
          },
          {
            "field": "state.program_state",
            "label": "Program state",
            "value_format": "status"
          }
        ],
        "max_rows": 20,
        "resource_kinds": [
          "FORWARDING_GROUP",
          "ETG",
          "ETE"
        ],
        "sort_direction": "ascending",
        "sort_field": "kind",
        "table_id": "forwarding-paths",
        "title": "Forwarding paths"
      },
      {
        "columns": [
          {
            "field": "label",
            "label": "Resource",
            "value_format": "resource"
          },
          {
            "field": "status",
            "label": "Status",
            "value_format": "status"
          },
          {
            "field": "state.match",
            "label": "Match",
            "value_format": "auto"
          },
          {
            "field": "state.packet_action",
            "label": "Packet action",
            "value_format": "auto"
          },
          {
            "field": "state.next_hop_mode",
            "label": "Next hop",
            "value_format": "text"
          }
        ],
        "max_rows": 12,
        "resource_kinds": [
          "DTE"
        ],
        "sort_direction": "ascending",
        "sort_field": "label",
        "table_id": "disposition-actions",
        "title": "Disposition actions"
      }
    ],
    "title": "Forwarding health"
  },
  {
    "collapsible": true,
