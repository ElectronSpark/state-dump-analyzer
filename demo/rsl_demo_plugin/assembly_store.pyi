from .archive import ASSEMBLY_GENERATOR as ASSEMBLY_GENERATOR, ASSEMBLY_ROOT as ASSEMBLY_ROOT
from collections.abc import Callable, Mapping
from dataclasses import dataclass
from pathlib import Path
from router_dump_analyzer.revision_store import RevisionDescriptor
from typing import Any

__all__ = ['ASSEMBLY_GENERATOR', 'ASSEMBLY_ROOT', 'DemoAssemblyError', 'DemoAssemblyStore']

class DemoAssemblyError(RuntimeError): ...
DatasetLoader = Callable[[Path, str], dict[str, Any]]

@dataclass(slots=True)
class _DatasetEntry:
    revision_id: str
    dataset: dict[str, Any]
    lease_count: int = ...
    closed: bool = ...

class _LeasedDataset(dict[str, Any]):
    def __init__(self, source: Mapping[str, Any], *, release: Callable[[], None], retain: Callable[[Mapping[str, Any]], '_LeasedDataset']) -> None: ...
    def release(self) -> None: ...
    def copy(self) -> _LeasedDataset: ...
    def __enter__(self) -> _LeasedDataset: ...
    def __exit__(self, *_exc_info: object) -> None: ...

class DemoAssemblyStore:
    archive_path: Path
    cache_size: int
    coverage: dict[str, Any]
    manifest: dict[str, Any]
    def __init__(self, archive_path: Path, *, cache_size: int = 2, dataset_loader: DatasetLoader | None = None) -> None: ...
    def revision(self, revision_id: str) -> RevisionDescriptor: ...
    def revision_for_node(self, node_id: str) -> RevisionDescriptor: ...
    def dataset_for_node(self, node_id: str) -> Mapping[str, Any]: ...
    def projection_for_node(self, node_id: str) -> Mapping[str, Any]: ...
    def dataset_for_revision(self, revision_id: str) -> Mapping[str, Any]: ...
    def loaded_revision_ids(self) -> tuple[str, ...]: ...
    def close(self) -> None: ...
    def __enter__(self) -> DemoAssemblyStore: ...
    def __exit__(self, *_exc_info: object) -> None: ...
