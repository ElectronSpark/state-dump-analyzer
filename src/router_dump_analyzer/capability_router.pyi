from .capability_executor import ConsistencyExecutionResult, CorrelationExecutionResult, EvidenceAnalysisExecutionResult, ForwardingProjectionExecutionResult, ForwardingStepExecutionResult, PluginCapabilityLimits, RelationshipProjectionExecutionResult, TopologyExecutionResult
from .ingestion_pipeline import PluginRegistry, RegisteredPlugin
from .plugin_api import ChangeSet, CorrelationReader, CorrelationWindow, DomainEvent, EvidenceAnalysisRequest, ForwardingProjectionRequest, ForwardingStepRequest, PluginCapability, ReadOnlyWorld, TopologyProjectionRequest
from .plugin_execution_plan import PluginExecutionPin, PluginExecutionPlan
from collections.abc import Callable, Iterable
from dataclasses import dataclass, field
from enum import Enum

__all__ = ['CapabilityRoutingError', 'CapabilityPlanUnavailableError', 'CapabilityRouteMissingError', 'CapabilityRouteAmbiguousError', 'CapabilityRouteStaleError', 'RevisionSetCapabilityFailureCode', 'CapabilityProviderRegistry', 'CapabilityRouteSelector', 'CapabilityProviderRef', 'CapabilityInvocation', 'RevisionSetCapabilityKey', 'RevisionSetCapabilityResolution', 'RevisionSetCapabilityFailure', 'RevisionSetCapabilityFanout', 'PlanBoundCapabilityRouter', 'PlanBoundCapabilityRoute', 'RevisionSetCapabilityRouter']

class CapabilityRoutingError(RuntimeError): ...
class CapabilityPlanUnavailableError(CapabilityRoutingError): ...
class CapabilityRouteMissingError(CapabilityRoutingError): ...
class CapabilityRouteAmbiguousError(CapabilityRoutingError): ...
class CapabilityRouteStaleError(CapabilityRoutingError): ...

class RevisionSetCapabilityFailureCode(str, Enum):
    INPUT_REJECTED = 'input_rejected'
    CAPABILITY_UNAVAILABLE = 'capability_unavailable'
    OUTPUT_REJECTED = 'output_rejected'
    EXECUTION_FAILED = 'execution_failed'
    ROUTING_FAILED = 'routing_failed'

class CapabilityProviderRegistry:
    def __init__(self, providers: Iterable[RegisteredPlugin] = ()) -> None: ...
    @classmethod
    def from_primary_registry(cls, registry: PluginRegistry) -> CapabilityProviderRegistry: ...
    def add_registered(self, provider: RegisteredPlugin) -> str: ...
    def instance_ids(self) -> tuple[str, ...]: ...
    def records(self) -> tuple[RegisteredPlugin, ...]: ...
    def get_by_execution_identity(self, instance_id: str, registered_execution_identity: str) -> RegisteredPlugin: ...
    def schema_digest_by_execution_identity(self, instance_id: str, registered_execution_identity: str) -> str: ...
    def snapshot_exact(self, coordinates: tuple[tuple[str, str], ...]) -> CapabilityProviderRegistry: ...

@dataclass(frozen=True, slots=True)
class CapabilityRouteSelector:
    capability: PluginCapability
    role: str | None = ...
    instance_id: str | None = ...
    def __post_init__(self) -> None: ...

@dataclass(frozen=True, slots=True)
class CapabilityProviderRef:
    catalog_revision_id: str
    member_id: str
    node_id: str
    basis_revision_id: str
    plan_digest: str
    capability: PluginCapability
    pin: PluginExecutionPin
    def __post_init__(self) -> None: ...

@dataclass(frozen=True, slots=True)
class CapabilityInvocation[ResultT]:
    provider: CapabilityProviderRef
    result: ResultT

@dataclass(frozen=True, slots=True, order=True)
class RevisionSetCapabilityKey:
    catalog_revision_id: str
    member_id: str
    def __post_init__(self) -> None: ...

@dataclass(frozen=True, slots=True)
class RevisionSetCapabilityResolution:
    routes: tuple[PlanBoundCapabilityRoute, ...]
    missing: tuple[RevisionSetCapabilityKey, ...]
    def __post_init__(self) -> None: ...

@dataclass(frozen=True, slots=True)
class RevisionSetCapabilityFailure:
    key: RevisionSetCapabilityKey
    provider: CapabilityProviderRef
    code: RevisionSetCapabilityFailureCode
    def __post_init__(self) -> None: ...

@dataclass(frozen=True, slots=True)
class RevisionSetCapabilityFanout[ResultT]:
    invocations: tuple[CapabilityInvocation[ResultT], ...]
    missing: tuple[RevisionSetCapabilityKey, ...]
    failures: tuple[RevisionSetCapabilityFailure, ...]
    def __post_init__(self) -> None: ...

@dataclass(frozen=True, slots=True)
class _BoundProvider:
    pin: PluginExecutionPin
    registered: RegisteredPlugin = field(repr=False, compare=False)

class PlanBoundCapabilityRouter:
    catalog_revision_id: str
    member_id: str
    plan: PluginExecutionPlan
    limits: PluginCapabilityLimits
    allow_inline_only: bool
    def __init__(self, providers: CapabilityProviderRegistry, plan: PluginExecutionPlan | None, *, catalog_revision_id: str, member_id: str, limits: PluginCapabilityLimits | None = None, allow_inline_only: bool = False) -> None: ...
    def resolve(self, selector: CapabilityRouteSelector) -> PlanBoundCapabilityRoute: ...

@dataclass(frozen=True, slots=True)
class PlanBoundCapabilityRoute:
    _router: PlanBoundCapabilityRouter
    selector: CapabilityRouteSelector
    _pin: PluginExecutionPin
    def __post_init__(self) -> None: ...
    @property
    def provider(self) -> CapabilityProviderRef: ...
    def apply(self, event: DomainEvent, world: ReadOnlyWorld) -> CapabilityInvocation[ChangeSet]: ...
    def revert(self, event: DomainEvent, world_after: ReadOnlyWorld) -> CapabilityInvocation[ChangeSet]: ...
    def correlate(self, reader: CorrelationReader, window: CorrelationWindow) -> CapabilityInvocation[CorrelationExecutionResult]: ...
    def project_relationships(self, world: ReadOnlyWorld) -> CapabilityInvocation[RelationshipProjectionExecutionResult]: ...
    def check_consistency(self, world: ReadOnlyWorld) -> CapabilityInvocation[ConsistencyExecutionResult]: ...
    def project_topology(self, request: TopologyProjectionRequest, world: ReadOnlyWorld) -> CapabilityInvocation[TopologyExecutionResult]: ...
    def project_forwarding(self, request: ForwardingProjectionRequest, world: ReadOnlyWorld) -> CapabilityInvocation[ForwardingProjectionExecutionResult]: ...
    def resolve_forwarding_step(self, request: ForwardingStepRequest, world: ReadOnlyWorld) -> CapabilityInvocation[ForwardingStepExecutionResult]: ...
    def analyze_evidence(self, request: EvidenceAnalysisRequest) -> CapabilityInvocation[EvidenceAnalysisExecutionResult]: ...

class RevisionSetCapabilityRouter:
    def __init__(self, routers: Iterable[PlanBoundCapabilityRouter]) -> None: ...
    @property
    def keys(self) -> tuple[RevisionSetCapabilityKey, ...]: ...
    def resolve(self, key: RevisionSetCapabilityKey, selector: CapabilityRouteSelector) -> PlanBoundCapabilityRoute: ...
    def resolve_all(self, selector: CapabilityRouteSelector) -> RevisionSetCapabilityResolution: ...
    def fanout[ResultT](self, selector: CapabilityRouteSelector, operation: Callable[[PlanBoundCapabilityRoute], CapabilityInvocation[ResultT]]) -> RevisionSetCapabilityFanout[ResultT]: ...
