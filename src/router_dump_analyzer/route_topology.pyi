    def node_contract(self, node_id: str) -> Mapping[str, Any] | None: ...
    def normalize_node_queries(self, body: Mapping[str, Any]) -> tuple[Mapping[str, Any], ...]: ...
    def normalize_projection_selection(self, node_id: str, request: Mapping[str, Any]) -> RouteProjectionSelection: ...
    def normalize_basis(self, basis: Any, field: str = 'basis') -> dict[str, Any]: ...
