def validity_bounds(minimum_value: object, maximum_value: object, label: str, *, allow_open: bool = True, allow_partial: bool = False, exact_integers: bool = True, minimum_type_message: str | None = None, maximum_type_message: str | None = None, presence_message: str | None = None, order_message: str | None = None) -> tuple[int | None, int | None]: ...
