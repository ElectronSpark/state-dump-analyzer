from array import array
from collections.abc import Callable as Callable, Iterable
from pathlib import Path

class HistorySearchCapacityError(RuntimeError): ...
class _SidecarUnavailable(RuntimeError): ...

class HistorySearchCorpus:
    def __init__(self, *, sidecar_path: Path | None = None, identity: str | None = None, expected_documents: int | None = None, eager_validate_sidecar: bool = True, max_documents: int = 250000, max_characters: int = ..., max_document_bytes: int = ..., max_database_bytes: int = ..., max_eager_candidate_characters: int = ..., max_cached_queries: int = 12, max_cached_ordinals: int = 1000000) -> None: ...
    @property
    def ready(self) -> bool: ...
    @property
    def document_count(self) -> int: ...
    @property
    def character_count(self) -> int: ...
    @property
    def storage_mode(self) -> str: ...
    @property
    def candidate_backend(self) -> str: ...
    @property
    def sidecar_path(self) -> Path | None: ...
    def status_snapshot(self) -> dict[str, object]: ...
    def ensure(self, documents: Callable[[], Iterable[str]]) -> None: ...
    def query(self, needle: str, documents: Callable[[], Iterable[str]]) -> array[int]: ...
    def close(self) -> None: ...
