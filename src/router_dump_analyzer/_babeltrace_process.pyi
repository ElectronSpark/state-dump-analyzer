import threading
from .plugin_api import ArtifactReader, CtfMessage, InputSpec
from _typeshed import Incomplete
from collections.abc import Callable, Iterator
from dataclasses import dataclass
from typing import Any

__all__ = ['TraceDecodeError', 'BabeltraceDecoderConfiguration', 'BabeltraceProcessDecoder']

class TraceDecodeError(RuntimeError):
    code: Incomplete
    def __init__(self, code: str, message: str) -> None: ...

@dataclass(frozen=True, slots=True)
class BabeltraceDecoderConfiguration:
    python_executable: str = ...
    timeout_seconds: float = ...
    max_messages: int = ...
    max_frame_bytes: int = ...
    max_output_bytes: int = ...
    max_metadata_bytes: int = ...
    max_field_depth: int = ...
    max_field_items: int = ...
    max_worker_memory_bytes: int = ...
    def __post_init__(self) -> None: ...

class _FrameChannel:
    condition: Incomplete
    pending: list[Any]
    def __init__(self) -> None: ...
    def put(self, frame: Any, stopped: threading.Event) -> None: ...
    def get(self, timeout: float) -> Any: ...

class BabeltraceProcessDecoder:
    configuration: Incomplete
    cancellation_probe: Incomplete
    def __init__(self, configuration: BabeltraceDecoderConfiguration | None = None, *, cancellation_probe: Callable[[], bool] | None = None) -> None: ...
    def iter_ctf(self, reader: ArtifactReader, spec: InputSpec) -> Iterator[CtfMessage]: ...
