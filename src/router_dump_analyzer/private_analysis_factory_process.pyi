from .private_analysis.contracts import PrivateAnalysisRequest
from .private_analysis.evidence import EvidenceReference
from .private_analysis_tool_service import PrivateAnalysisToolBudgetState, _PrivateAnalysisToolRunLeaseFacade
from collections.abc import Callable
from dataclasses import dataclass, field
from enum import StrEnum
from typing import Any

__all__ = ['PrivateAnalysisFactoryPreparationFailed', 'PrivateAnalysisFactoryPreparationTimedOut', 'PrivateAnalysisFactoryPreparationCancelled', 'PrivateAnalysisToolServiceProcessFactory', 'PrivateAnalysisRemoteToolService', 'PrivateAnalysisRemoteToolRunLease', 'start_private_analysis_tool_service_process']

class _PrivateAnalysisFactoryProcessMessageKind(StrEnum):
    READY = 'ready'
    EXECUTE = 'execute'
    RESPONSE = 'response'
    CLOSE = 'close'
    CLOSED = 'closed'
    FAILED = 'failed'

class PrivateAnalysisFactoryProcessError(RuntimeError):
    def __init__(self, message: str, *, cleanup_owner: PrivateAnalysisFactoryProcessCleanupOwner | None = None) -> None: ...
    @property
    def cleanup_owner(self) -> PrivateAnalysisFactoryProcessCleanupOwner | None: ...

class PrivateAnalysisFactoryPreparationFailed(PrivateAnalysisFactoryProcessError): ...
class PrivateAnalysisFactoryPreparationTimedOut(PrivateAnalysisFactoryProcessError): ...
class PrivateAnalysisFactoryPreparationCancelled(PrivateAnalysisFactoryProcessError): ...
class PrivateAnalysisFactoryProcessCleanupError(PrivateAnalysisFactoryProcessError): ...
class PrivateAnalysisFactoryExecutableIdentityError(PrivateAnalysisFactoryProcessError): ...

@dataclass(frozen=True, slots=True)
class PrivateAnalysisToolServiceProcessFactory:
    target: str
    configuration_json: str = field(default='{}', repr=False)
    executable_identity: str | None = field(default=None, repr=False)
    def __post_init__(self) -> None: ...
    @staticmethod
    def detached(value: object) -> PrivateAnalysisToolServiceProcessFactory: ...
    @staticmethod
    def resolved(value: object) -> PrivateAnalysisToolServiceProcessFactory: ...
    @property
    def configuration(self) -> dict[str, Any]: ...
    @property
    def configuration_digest(self) -> str: ...
    def evidence_service_digest(self, semantic_digest: str) -> str: ...

class PrivateAnalysisRemoteToolService:
    def __init__(self, request: PrivateAnalysisRequest, *, process: Any, connection: Any, cancellation_probe: Callable[[], bool], deadline_ns: int, poll_interval_ns: int) -> None: ...
    @property
    def request(self) -> PrivateAnalysisRequest: ...
    @property
    def budget_state(self) -> PrivateAnalysisToolBudgetState: ...
    @property
    def disclosed_references(self) -> tuple[EvidenceReference, ...]: ...
    @property
    def runner_lease_eligible(self) -> bool: ...
    def acquire_run_lease(self) -> PrivateAnalysisRemoteToolRunLease: ...
    def close(self) -> None: ...

class PrivateAnalysisRemoteToolRunLease(_PrivateAnalysisToolRunLeaseFacade):
    def __init__(self, service: PrivateAnalysisRemoteToolService) -> None: ...

class PrivateAnalysisFactoryProcessCleanupOwner:
    def __init__(self, process: Any) -> None: ...
    @property
    def cleanup_confirmed(self) -> bool: ...
    def close(self) -> None: ...

def start_private_analysis_tool_service_process(factory: PrivateAnalysisToolServiceProcessFactory, request: PrivateAnalysisRequest, *, cancellation_probe: Callable[[], bool], absolute_deadline_ns: int, poll_interval_ns: int) -> PrivateAnalysisRemoteToolService: ...

# Importable cleanup helper used by another typed core module.
def private_analysis_factory_process_cleanup_owner(
    error: BaseException,
) -> PrivateAnalysisFactoryProcessCleanupOwner | None: ...
