import argparse
from .control_plane_server import ControlPlaneApplicationFactory
from collections.abc import Callable, Sequence
from dataclasses import dataclass
from pathlib import Path
from typing import Any

__all__ = ['ServerConfiguration', 'build_parser', 'parse_args', 'run', 'main']

@dataclass(frozen=True, slots=True)
class ServerConfiguration:
    state_dir: Path
    plugin_names: tuple[str, ...]
    plugin_modules: tuple[str, ...]
    host: str
    port: int
    identity_resolver_module: str | None
    trust_control_plane_headers: bool
    grant_instance_operator: bool = ...
    retention_policy_path: Path | None = ...
    expose_api_docs: bool = ...
    private_analysis_deployment_module: str | None = ...
    plugin_deployment_module: str | None = ...

def build_parser() -> argparse.ArgumentParser: ...
def parse_args(argv: Sequence[str] | None = None) -> ServerConfiguration: ...
def run(configuration: ServerConfiguration, *, entry_point_loader: Callable[[str], Any] = ..., module_loader: Callable[[str], Any] = ..., identity_resolver_loader: Callable[[str], Callable[[Any], Any]] = ..., private_analysis_deployment_loader: Callable[..., Any] = ..., plugin_deployment_loader: Callable[..., Any] = ..., application_factory: ControlPlaneApplicationFactory = ..., server_runner: Callable[..., None] = ..., registry_factory: Callable[..., Any] = ..., control_plane_factory: Callable[..., Any] = ...) -> None: ...
def main(argv: Sequence[str] | None = None) -> None: ...
