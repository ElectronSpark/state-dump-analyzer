class RouteTraceContractError(ValueError): ...

@dataclass(frozen=True, slots=True)
class ForwardingTraversalEvaluation:
    outcome: str
    stop_step: int
    terminal_reason: str | None
    cycle: ForwardingCycleReport | None = ...
