from .annotation_store import ReviewScope
from .control_plane import ControlPlane
from .normalized_data import IndexedHistory
from .revision_store import AssemblyDescriptor, RevisionDescriptor
from collections.abc import Mapping
from dataclasses import dataclass
from typing import Any

__all__ = ['ManagementAnalysisRequestError', 'ManagementAnalysisQuery', 'parse_management_analysis_query', 'query_management_analysis']

class ManagementAnalysisRequestError(ValueError): ...

@dataclass(frozen=True, slots=True)
class ManagementAnalysisQuery:
    selector: Mapping[str, Any]
    selected_revision_id: str | None = ...
    selected_member_id: str | None = ...
    expected_revision_vector_digest: str | None = ...
    section: str = ...
    limit: int = ...
    offset: int = ...
    search: str = ...
    time_ns: int | None = ...
    start_ns: int | None = ...
    end_ns: int | None = ...

def parse_management_analysis_query(payload: Mapping[str, Any]) -> ManagementAnalysisQuery: ...

class _SelectedStore:
    dataset: dict[str, Any]
    descriptor: RevisionDescriptor
    def __init__(self, dataset: dict[str, Any], member: dict[str, Any]) -> None: ...
    @property
    def default_revision_id(self) -> str: ...
    @property
    def assembly(self) -> AssemblyDescriptor: ...
    def revision(self, revision_id: str) -> RevisionDescriptor: ...
    def revision_for_node(self, node_id: str) -> RevisionDescriptor: ...
    def dataset_for_revision(self, revision_id: str) -> Mapping[str, Any]: ...
    def dataset_for_node(self, node_id: str) -> Mapping[str, Any]: ...
    def loaded_revision_ids(self) -> tuple[str, ...]: ...

class _ResourceIndex:
    resources: list[dict[str, Any]]
    resource_by_id: Mapping[str, dict[str, Any]]
    resources_by_kind: Mapping[str, list[dict[str, Any]]]
    resource_counts: Mapping[str, int]
    lifecycle_by_resource: Mapping[str, list[dict[str, Any]]]
    state_by_resource: Mapping[str, list[dict[str, Any]]]
    events: list[dict[str, Any]]
    event_by_uid: Mapping[str, dict[str, Any]]
    event_times: list[int]
    events_by_resource: Mapping[str, list[dict[str, Any]]]
    relationships: list[dict[str, Any]]
    relationships_by_endpoint: Mapping[str, list[dict[str, Any]]]
    mutations: list[dict[str, Any]]
    mutation_times: list[int]
    mutations_by_endpoint: Mapping[str, list[dict[str, Any]]]
    initial_resource_ids: list[str]
    event_search: Any
    resource_search: Any
    event_redaction_policy: Any
    def __init__(self, dataset: Mapping[str, Any]) -> None: ...

class _ResourceSource:
    store: _SelectedStore
    index: _ResourceIndex
    def __init__(self, store: _SelectedStore) -> None: ...
    def revision_scope(self, revision_id: str) -> Any: ...
    def load_dataset(self, revision_id: str | None = None, **selection: Any) -> dict[str, Any]: ...
    def revision_id(self, dataset: Mapping[str, Any]) -> str: ...
    def indexed_history(self, dataset: Mapping[str, Any]) -> IndexedHistory: ...

def query_management_analysis(control_plane: ControlPlane, scope: ReviewScope, query: ManagementAnalysisQuery) -> dict[str, Any]: ...
