    def detached(self) -> ConfiguredPrivateAnalysisSubprocessRunner: ...
    @property
    def cleanup_pending(self) -> bool: ...
    def retry_pending_cleanup(self) -> tuple[bool, PrivateAnalysisSubprocessExecutionReceipt | None]: ...
    def acknowledge_pending_cleanup(self) -> None: ...
    def execute(self, tool_service: PrivateAnalysisToolService | PrivateAnalysisRemoteToolService, *, accounting_observer: PrivateAnalysisAccountingObserver | None = None, cancellation_probe: PrivateAnalysisCancellationProbe | None = None, absolute_deadline_ns: int | None = None) -> PrivateAnalysisSubprocessExecutionReceipt: ...
