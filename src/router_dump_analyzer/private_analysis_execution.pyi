from collections.abc import Callable
from dataclasses import dataclass, field

type CorePrivateAnalysisRunner = ConfiguredPrivateAnalysisInProcessRunner | ConfiguredPrivateAnalysisSubprocessRunner
type PrivateAnalysisExecutionReceipt = PrivateAnalysisInProcessExecutionReceipt | PrivateAnalysisSubprocessExecutionReceipt
type PrivateAnalysisToolServiceFactory = Callable[[PrivateAnalysisRequest], PrivateAnalysisToolService]
type PrivateAnalysisRuntimeToolService = PrivateAnalysisToolService | PrivateAnalysisRemoteToolService
type CorePrivateAnalysisToolServiceFactory = Callable[[PrivateAnalysisRequest, PrivateAnalysisPolicy, Callable[[], bool]], PrivateAnalysisToolService]
class PrivateAnalysisExecutionError(RuntimeError): ...
class PrivateAnalysisExecutionUnavailable(PrivateAnalysisExecutionError): ...
class PrivateAnalysisExecutionClosed(PrivateAnalysisExecutionError): ...
class PrivateAnalysisExecutionCloseTimeout(PrivateAnalysisExecutionError): ...
class _AttemptLost(PrivateAnalysisExecutionUnavailable): ...

class _CleanupFenceEstablishedAfterError(RuntimeError):
    original: BaseException
    def __init__(self, original: BaseException) -> None: ...

@dataclass(frozen=True, slots=True)
class PrivateAnalysisRunnerRegistration:
    runner: CorePrivateAnalysisRunner
    trusted_inline_tool_service_factory: PrivateAnalysisToolServiceFactory | None = ...
    tool_service_process_factory: PrivateAnalysisToolServiceProcessFactory | None = ...
    core_revision_evidence_policy: PrivateAnalysisPolicy | None = ...
    custom_evidence_service_digest: str | None = ...
    evidence_service_digest: str = field(init=False)
    def __post_init__(self) -> None: ...
    def detached(self) -> PrivateAnalysisRunnerRegistration: ...

@dataclass(frozen=True, slots=True)
class PrivateAnalysisRegisteredRunner:
    selection: PrivateAnalysisRunnerSelection
    instruction_profile_digest: str
    evidence_service_digest: str = ...
    def __post_init__(self) -> None: ...

@dataclass(frozen=True, slots=True)
class PrivateAnalysisExecutionLimits:
    max_concurrent_runs: int = ...
    lease_duration_ns: int = ...
    heartbeat_interval_ns: int = ...
    cancellation_poll_interval_ns: int = ...
    monitor_join_timeout_ns: int = ...
    def __post_init__(self) -> None: ...

@dataclass(slots=True)
class _RegisteredRunner:
    registration: PrivateAnalysisRunnerRegistration

@dataclass(slots=True)
class _ConfirmedFactoryCleanupOwner:
    cleanup_confirmed: bool = ...
    def close(self) -> None: ...
type _FactoryCleanupOwner = PrivateAnalysisRemoteToolService | PrivateAnalysisFactoryProcessCleanupOwner | _ConfirmedFactoryCleanupOwner

@dataclass(slots=True)
class _PrelaunchCleanupJournal:
    attempt: _DurableExecutionAttempt
    cleanup_capability: str = field(repr=False)
    receipt: PrivateAnalysisExecutionReceipt | None = ...
    finalize_unstarted: bool = ...
    timed_out: bool = ...
    retry_ready: bool = ...
    retry_lock: threading.Lock = field(default_factory=threading.Lock)

@dataclass(slots=True)
class _PendingFactoryCleanup:
    owner: _FactoryCleanupOwner
    attempt: _DurableExecutionAttempt
    cleanup_capability: str = field(repr=False)
    receipt: PrivateAnalysisExecutionReceipt | None = ...
    receipt_runner: ConfiguredPrivateAnalysisInProcessRunner | None = ...
    finalize_unstarted: bool = ...
    timed_out: bool = ...
    retry_ready: bool = ...
    retry_lock: threading.Lock = field(default_factory=threading.Lock)

@dataclass(slots=True)
class _PendingSubprocessCleanup:
    runner: ConfiguredPrivateAnalysisSubprocessRunner
    attempt: _DurableExecutionAttempt
    cleanup_capability: str = field(repr=False)
    service: PrivateAnalysisRemoteToolService | None = ...
    receipt: PrivateAnalysisExecutionReceipt | None = ...
    finalize_unstarted: bool = ...
    timed_out: bool = ...
    retry_ready: bool = ...
    retry_lock: threading.Lock = field(default_factory=threading.Lock)

class _DurableExecutionAttempt:
    def __init__(self, store: SqlitePrivateAnalysisRunStore, record: PrivateAnalysisRunRecord, *, actor_id: str, limits: PrivateAnalysisExecutionLimits, monitor_exit: Callable[[_DurableExecutionAttempt], None]) -> None: ...
    @property
    def record(self) -> PrivateAnalysisRunRecord: ...
    @property
    def execution_id(self) -> str: ...
    def start_monitor(self) -> None: ...
    def stop_monitor(self) -> None: ...
    def signal_cancellation(self, record: PrivateAnalysisRunRecord | None = None) -> None: ...
    def cancellation_probe(self) -> bool: ...
    def accounting_observer(self, references: tuple[EvidenceReference, ...], budget_state: PrivateAnalysisToolBudgetState) -> None: ...
    def refresh(self) -> PrivateAnalysisRunRecord: ...
    def complete(self, receipt: PrivateAnalysisExecutionReceipt) -> PrivateAnalysisRunRecord: ...
    def complete_cleanup(self, receipt: PrivateAnalysisExecutionReceipt, cleanup_capability: str) -> PrivateAnalysisRunRecord: ...
    def finalize_unstarted(self, *, timed_out: bool = False) -> PrivateAnalysisRunRecord: ...
    def finalize_cleanup_unstarted(self, cleanup_capability: str, *, timed_out: bool = False) -> PrivateAnalysisRunRecord: ...
    def begin_cleanup_fence(self, cleanup_capability: str) -> None: ...
    def note_cleanup_attempt(self, cleanup_capability: str) -> None: ...
    def cleanup_fence_matches(self, cleanup_capability: str) -> bool | None: ...

class PrivateAnalysisExecutionCoordinator:
    def __init__(self, store: SqlitePrivateAnalysisRunStore, *, registrations: tuple[PrivateAnalysisRunnerRegistration, ...] = (), limits: PrivateAnalysisExecutionLimits | None = None, core_tool_service_factory: CorePrivateAnalysisToolServiceFactory | None = None) -> None: ...
    def resolve_runner(self, runner_id: str, runner_version: str) -> PrivateAnalysisRegisteredRunner: ...
    def list_runners(self) -> tuple[PrivateAnalysisRegisteredRunner, ...]: ...
    def is_bound_to_store(self, store: object) -> bool: ...
    def execute_run(self, scope: EvidenceScope, run_id: str, *, expected_version: int, actor_id: str, execution_id: str | None = None) -> PrivateAnalysisRunRecord: ...
    def retry_pending_cleanup(self, *, limit: int = 100, scope: EvidenceScope | None = None) -> tuple[PrivateAnalysisRunRecord, ...]: ...
    @property
    def locally_owned_cleanup_count(self) -> int: ...
    def request_cancellation(self, scope: EvidenceScope, run_id: str, *, expected_version: int, actor_id: str) -> PrivateAnalysisRunRecord: ...
    def recover_expired_runs(self, *, actor_id: str, limit: int = 100, scope: EvidenceScope | None = None) -> tuple[PrivateAnalysisRunRecord, ...]: ...
    def close(self, *, timeout: float = 30.0) -> None: ...
