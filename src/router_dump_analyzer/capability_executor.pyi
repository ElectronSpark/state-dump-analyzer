class _BoundedWorld:
    def __init__(self, world: ReadOnlyWorld, maximum_reads: int, capability: PluginCapability, *, basis: WorldBasis, perspective_ref: StatusPerspectiveRef | None, maximum_evidence: int) -> None: ...
