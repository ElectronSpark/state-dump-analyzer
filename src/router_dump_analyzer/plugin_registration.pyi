from .ingestion import IngestionCoordinator
from .ingestion_contracts import IngestionPipelineError
from .plugin_api import AnalyzerPlugin, PluginManifest
from .plugin_execution_plan import DecoderIdentity, PluginExecutionPin
from collections.abc import Iterable, Mapping
from dataclasses import dataclass
from enum import StrEnum
from pathlib import Path
from typing import Any, Final

__all__ = ['PluginCandidate', 'RegisteredPlugin', 'registered_plugin_matches_execution_pin', 'PluginRegistry']

class _ProcessTargetKind(StrEnum):
    PLUGIN = 'plug-in'
    COORDINATOR = 'coordinator'
    DECODER = 'decoder'

class _ProcessTargetIdentityUnavailable(IngestionPipelineError):
    reason_code: Final[str]
    target_kind: _ProcessTargetKind
    def __init__(self, target_kind: _ProcessTargetKind) -> None: ...

@dataclass(frozen=True, slots=True)
class PluginCandidate:
    plugin_id: str
    plugin_version: str
    package_hash: str
    confidence: float
    match_kind: str
    instance_id: str = ...
    registered_execution_identity: str = ...
    reasons: tuple[str, ...] = ...
    detected_platform: str | None = ...
    detected_software_version: str | None = ...
    def as_dict(self) -> dict[str, Any]: ...

@dataclass(frozen=True, slots=True)
class _PinnedManifestPlugin:
    original: Any
    manifest: PluginManifest
    def __getattr__(self, name: str) -> Any: ...

class _IdentityBoundTraceDecoder:
    def __init__(self, decoder: Any, identity: DecoderIdentity) -> None: ...
    @property
    def identity(self) -> DecoderIdentity: ...
    def iter_ctf(self, *args: Any, **kwargs: Any) -> Any: ...

@dataclass(frozen=True, slots=True)
class _PluginProcessBootstrap:
    schema_version: str
    plugin_loader_kind: str
    plugin_target: str
    plugin_target_executable_identity: str
    coordinator_loader_kind: str
    coordinator_target: str | None
    coordinator_target_executable_identity: str | None
    decoder_loader_kind: str
    decoder_target: str | None
    decoder_target_executable_identity: str | None
    ingestion_limit_values: tuple[int, ...]
    artifact_limit_values: tuple[int, ...]
    package_hash: str
    verify_package_bytes: bool
    instance_id: str
    distribution_name: str
    distribution_version: str
    entry_point_name: str
    module_target: str
    configuration_digest: str
    decoder_identity_values: tuple[str, str, str] | None
    expected_registered_execution_identity: str

@dataclass(frozen=True, slots=True)
class RegisteredPlugin:
    plugin: Any
    coordinator: IngestionCoordinator
    package_hash: str
    verify_package_bytes: bool
    instance_id: str = ...
    distribution_name: str = ...
    distribution_version: str = ...
    entry_point_name: str = ...
    module_target: str = ...
    configuration_digest: str = ...
    core_api_version: str = ...
    capabilities: tuple[str, ...] = ...
    schema_versions: tuple[str, ...] = ...
    timeline_time_basis: str = ...
    timeline_clock_domain: str | None = ...
    decoder_identity: DecoderIdentity | None = ...
    _plugin_id_snapshot: str | None = ...
    _plugin_version_snapshot: str | None = ...
    _manifest_identity_snapshot: str | None = ...
    _execution_plugin: Any | None = ...
    _decoder_implementation_snapshot: Any | None = ...
    _registered_execution_identity_snapshot: str | None = ...
    _ingestion_limit_values_snapshot: tuple[int, ...] = ...
    _artifact_limit_values_snapshot: tuple[int, ...] = ...
    _process_bootstrap: _PluginProcessBootstrap | None = ...
    _process_bootstrap_error: str | None = ...
    @property
    def plugin_id(self) -> str: ...
    @property
    def plugin_version(self) -> str: ...
    @property
    def execution_plugin(self) -> Any: ...
    def execution_identity_material(self) -> dict[str, Any]: ...
    @property
    def registered_execution_identity(self) -> str: ...
    @property
    def process_bootstrap(self) -> _PluginProcessBootstrap: ...
    @property
    def process_bootstrap_digest(self) -> str | None: ...

def registered_plugin_matches_execution_pin(pin: PluginExecutionPin, registered: RegisteredPlugin) -> bool: ...

class PluginRegistry:
    def __init__(self, plugins: Iterable[Any] = (), *, require_executable_identity: bool | None = None, allow_manifest_identity: bool = False) -> None: ...
    def register(self, plugin: AnalyzerPlugin, *, coordinator: IngestionCoordinator | None = None, package_hash: str | None = None, instance_id: str | None = None, distribution_name: str | None = None, distribution_version: str | None = None, entry_point_name: str | None = None, module_target: str | None = None, configuration_digest: str | None = None, decoder_identity: DecoderIdentity | None = None, plugin_process_module_target: str | None = None, plugin_process_construct_class: bool = False, coordinator_module_target: str | None = None, decoder_module_target: str | None = None) -> RegisteredPlugin: ...
    def get(self, plugin_id: str, plugin_version: str | None = None, *, instance_id: str | None = None, registered_execution_identity: str | None = None) -> RegisteredPlugin: ...
    def records(self) -> tuple[RegisteredPlugin, ...]: ...
    def process_bootstraps(self) -> tuple[_PluginProcessBootstrap, ...]: ...
    def get_by_execution_identity(self, instance_id: str, registered_execution_identity: str) -> RegisteredPlugin: ...
    @staticmethod
    def revalidate_executable_identity(record: RegisteredPlugin) -> None: ...
    @classmethod
    def revalidate_manifest_identity(cls, record: RegisteredPlugin) -> None: ...
    @classmethod
    def revalidate_registered_identity(cls, record: RegisteredPlugin) -> None: ...
    def require_executable_identities(self) -> None: ...
    def fingerprint(self) -> str: ...
    def probe(self, input_path: Path, *, node_hint: str | None = None, metadata: Mapping[str, Any] | None = None) -> tuple[PluginCandidate, ...]: ...
