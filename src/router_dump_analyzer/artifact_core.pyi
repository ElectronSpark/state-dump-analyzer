import tarfile
from .plugin_api import DumpInventory, Value
from collections.abc import Mapping, Sequence
from dataclasses import dataclass
from pathlib import Path, PurePosixPath
from typing import BinaryIO, Literal, Self
from uuid import UUID

__all__ = ['ArtifactBoundaryError', 'ArtifactLimits', 'normalize_artifact_path', 'CoreArtifactReader', 'ScopedArtifactReader']

class ArtifactBoundaryError(RuntimeError): ...

@dataclass(frozen=True, slots=True)
class ArtifactLimits:
    max_artifacts: int = ...
    max_inventory_entries: int = ...
    max_path_depth: int = ...
    max_artifact_bytes: int = ...
    max_total_uncompressed_bytes: int = ...
    max_compression_ratio: int = ...
    def __post_init__(self) -> None: ...

def normalize_artifact_path(value: str) -> PurePosixPath: ...

@dataclass(frozen=True, slots=True)
class _FileIdentity:
    device: int
    inode: int
    mode: int
    size: int
    mtime_ns: int
    ctime_ns: int

@dataclass(frozen=True, slots=True)
class _ArtifactSource:
    artifact_id: UUID
    logical_path: PurePosixPath
    source_kind: Literal['file', 'directory', 'tar', 'zip']
    source_name: str | None
    compressed_size: int | None
    uncompressed_size: int
    media_type: str
    file_identity: _FileIdentity | None = ...
    zip_crc: int | None = ...
    tar_offset_data: int | None = ...
    tar_member: tarfile.TarInfo | None = ...

class CoreArtifactReader:
    limits: ArtifactLimits
    inventory: DumpInventory
    def __init__(self, input_path: Path, *, node_hint: str | None = None, metadata: Mapping[str, Value] | None = None, limits: ArtifactLimits | None = None) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, *_exc_info: object) -> None: ...
    def close(self) -> None: ...
    def open_binary(self, artifact_id: UUID) -> BinaryIO: ...
    def scoped(self, artifact_ids: Sequence[UUID]) -> ScopedArtifactReader: ...
    def materialize_private_path(self, artifact_id: UUID) -> str: ...
    def materialize_private_tree(self, artifact_ids: Sequence[UUID], logical_root: PurePosixPath | None = None) -> str: ...

class ScopedArtifactReader:
    inventory: DumpInventory
    def __init__(self, parent: CoreArtifactReader, artifact_ids: tuple[UUID, ...]) -> None: ...
    def open_binary(self, artifact_id: UUID) -> BinaryIO: ...
    def materialize_private_path(self, artifact_id: UUID) -> str: ...
    def materialize_private_tree(self, artifact_ids: Sequence[UUID], logical_root: PurePosixPath | None = None) -> str: ...
    def scoped(self, artifact_ids: Sequence[UUID]) -> ScopedArtifactReader: ...
