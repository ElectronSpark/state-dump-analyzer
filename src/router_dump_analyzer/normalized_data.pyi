__all__ = ['contains_time', 'overlaps_range', 'MAX_RESOURCE_TABLE_TRAVERSAL_NODES', 'IndexedHistory', 'NormalizedDatasetSource', 'NormalizedDataPolicy', 'resource_id', 'resource_label', 'active_interval', 'state_intervals_for_perspective', 'descriptor_property_rules', 'redact_resource_view', 'redact_resource_for_client', 'EventRedactionPolicy', 'NormalizedDataCancellationError', 'NormalizedDataCancellationRequested', 'NormalizedDataCancellationProbeError', 'NormalizedDataCancellationProbeResultError', 'event_redaction_policy', 'project_consistency_findings_for_client', 'project_consistency_materialization_for_client', 'redact_event_for_client', 'resource_search_text', 'NormalizedProviderError', 'NormalizedDataService']

MAX_RESOURCE_TABLE_TRAVERSAL_NODES: int

class IndexedHistory(Protocol):
    resources: list[dict[str, Any]]
    resource_by_id: Mapping[str, dict[str, Any]]
    resources_by_kind: Mapping[str, list[dict[str, Any]]]
    resource_counts: Mapping[str, int]
    events: list[dict[str, Any]]
    event_by_uid: Mapping[str, dict[str, Any]]
    event_times: list[int]
    events_by_resource: Mapping[str, list[dict[str, Any]]]
    lifecycle_by_resource: Mapping[str, list[dict[str, Any]]]
    state_by_resource: Mapping[str, list[dict[str, Any]]]
    relationships: list[dict[str, Any]]
    relationships_by_endpoint: Mapping[str, list[dict[str, Any]]]
    mutations: list[dict[str, Any]]
    mutation_times: list[int]
    mutations_by_endpoint: Mapping[str, list[dict[str, Any]]]
    initial_resource_ids: list[str]
    event_search: Any
    resource_search: Any
    event_redaction_policy: Any

class NormalizedDatasetSource(Protocol):
    def revision_scope(self, revision_id: str) -> AbstractContextManager[Any]: ...
    def load_dataset(self, revision_id: str | None = None, **selection: Any) -> dict[str, Any]: ...
    def revision_id(self, dataset: Mapping[str, Any]) -> str: ...
    def indexed_history(self, dataset: Mapping[str, Any]) -> IndexedHistory | None: ...

class NormalizedDataPolicy(Protocol):
    def analysis_metadata(self, dataset: Mapping[str, Any]) -> Mapping[str, Any]: ...
    def workspace_metadata(self, dataset: Mapping[str, Any], *, revision_id: str, history_mode: str) -> Mapping[str, Any]: ...
    def route_resolution_capability(self, dataset: Mapping[str, Any]) -> Mapping[str, Any]: ...
    def route_row(self, route_id: str, dataset: Mapping[str, Any]) -> Mapping[str, Any]: ...
    def source_record_for_event(self, event: Mapping[str, Any]) -> Mapping[str, Any]: ...

def resource_id(record: Mapping[str, Any]) -> str: ...
def resource_label(record: Mapping[str, Any] | None, identifier: str) -> str: ...
def active_interval(records: Iterable[dict[str, Any]], timestamp_ns: int) -> dict[str, Any] | None: ...
def state_intervals_for_perspective(records: Iterable[dict[str, Any]], perspective_ref: StatusPerspectiveRef) -> list[dict[str, Any]]: ...
def descriptor_property_rules(descriptor: Mapping[str, Any] | None) -> dict[str, Mapping[str, Any]]: ...
def redact_resource_view(view: Mapping[str, Any], descriptor: Mapping[str, Any] | None) -> dict[str, Any]: ...
def redact_resource_for_client(record: Mapping[str, Any], descriptor: Mapping[str, Any] | None) -> dict[str, Any]: ...
type EventRedactionPolicy = tuple[dict[str, frozenset[str]], dict[str, str], frozenset[str], dict[str, bool]]

class NormalizedDataCancellationError(RuntimeError): ...
class NormalizedDataCancellationRequested(NormalizedDataCancellationError): ...
class NormalizedDataCancellationProbeError(NormalizedDataCancellationError): ...
class NormalizedDataCancellationProbeResultError(NormalizedDataCancellationProbeError): ...

def event_redaction_policy(dataset: Mapping[str, Any], runtime: IndexedHistory | None = None, *, cancellation_probe: Callable[[], bool] | None = None) -> EventRedactionPolicy: ...
def project_consistency_findings_for_client(dataset: Mapping[str, Any], findings: Iterable[Mapping[str, Any]]) -> list[dict[str, Any]]: ...
def project_consistency_materialization_for_client(materialization: Mapping[str, Any]) -> dict[str, Any]: ...
def redact_event_for_client(event: Mapping[str, Any], dataset: Mapping[str, Any], *, runtime: IndexedHistory | None = None, policy: EventRedactionPolicy | None = None) -> dict[str, Any]: ...
def resource_search_text(record: Mapping[str, Any], view: Mapping[str, Any], descriptor: Mapping[str, Any] | None) -> str: ...

class NormalizedProviderError(RuntimeError): ...

class _ContainedRevisionScope(AbstractContextManager[Any]):
    def __init__(self, context: Any) -> None: ...
    def __enter__(self) -> Any: ...
    def __exit__(self, exc_type: type[BaseException] | None, exc_value: BaseException | None, traceback: TracebackType | None) -> bool: ...

class NormalizedDataService:
    source: NormalizedDatasetSource
    policy: NormalizedDataPolicy
    def __init__(self, source: NormalizedDatasetSource, policy: NormalizedDataPolicy, *, load_tracker: AnalysisLoadTracker | None = None) -> None: ...
    def revision_scope(self, revision_id: str) -> AbstractContextManager[Any]: ...
    def load_dataset(self, revision_id: str | None = None, **selection: Any) -> dict[str, Any]: ...
    def current_revision_id(self, dataset: Mapping[str, Any] | None = None) -> str: ...
    def history_runtime(self, dataset: Mapping[str, Any] | None = None) -> IndexedHistory | None: ...
    def has_indexed_history(self, dataset: Mapping[str, Any] | None = None) -> bool: ...
    def analysis_metadata(self, dataset: Mapping[str, Any]) -> Mapping[str, Any]: ...
    def route_resolution_capability(self, dataset: Mapping[str, Any] | None = None) -> dict[str, Any]: ...
    def route_row(self, route_id: str, dataset: Mapping[str, Any] | None = None) -> dict[str, Any]: ...
    def source_record_for_event(self, event: Mapping[str, Any]) -> dict[str, Any]: ...
    def event_redaction_policy(self, dataset: Mapping[str, Any] | None = None, *, cancellation_probe: Callable[[], bool] | None = None) -> EventRedactionPolicy: ...
    def redact_event_for_client(self, event: Mapping[str, Any], dataset: Mapping[str, Any] | None = None, *, policy: EventRedactionPolicy | None = None) -> dict[str, Any]: ...
    @staticmethod
    def redact_resource_for_client(record: Mapping[str, Any], descriptor: Mapping[str, Any] | None) -> dict[str, Any]: ...
    @staticmethod
    def redact_resource_view(view: Mapping[str, Any], descriptor: Mapping[str, Any] | None) -> dict[str, Any]: ...
    def client_dataset(self, revision_id: str | None = None, **selection: Any) -> dict[str, Any]: ...
    def resource_state_at(self, resource_identifier: str, timestamp_ns: int, *, perspective_ref: StatusPerspectiveRef | None = None) -> dict[str, Any]: ...
    def relationships_at(self, timestamp_ns: int) -> list[dict[str, Any]]: ...
    def redact_state_interval_for_client(self, resource_identifier: str, interval: Mapping[str, Any], dataset: Mapping[str, Any] | None = None) -> dict[str, Any]: ...
    def resources_at(self, timestamp_ns: int, *, kinds: set[str] | None = None, layers: set[str] | None = None, search: str | None = None, limit: int | None = None, offset: int = 0, view_id: str | None = None) -> dict[str, Any]: ...
    def events_in_range(self, start_ns: int, end_ns: int) -> list[dict[str, Any]]: ...
    def dashboard_query(self, timestamp_ns: int, *, dashboard_ids: Iterable[str] | None = None) -> dict[str, Any]: ...
    def range_summary(self, start_ns: int, end_ns: int) -> dict[str, Any]: ...
