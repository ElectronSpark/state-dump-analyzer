from .plugin_api import ReadOnlyWorld as ReadOnlyWorld, RelationDirection as RelationDirection, RelationshipView as RelationshipView, ResourceKey as ResourceKey, ResourceStateView as ResourceStateView, StatusPerspectiveRef as StatusPerspectiveRef, WorldBasis as WorldBasis
from .process_control import PROCESS_CONTROL_EXCEPTIONS as PROCESS_CONTROL_EXCEPTIONS
from collections.abc import Callable as Callable, Iterable, Iterator
from typing import Any

class WorldReadBudget:
    maximum: int
    remaining: int
    def __init__(self, maximum: int, error: Callable[[bool], Exception]) -> None: ...
    @property
    def used(self) -> int: ...
    def charge(self) -> None: ...
    def iterate[Item](self, producer: Callable[[int], Iterable[Item]], requested_limit: int | None, *, invoke: Callable[[Callable[[], Any], str], Any] = ..., transform: Callable[[Item], Item] = ..., suppress_secondary_close_errors: tuple[type[Exception], ...] = ()) -> Iterator[Item]: ...

class AggregateReadWorld:
    def __init__(self, world: ReadOnlyWorld, *, basis: WorldBasis, perspective_ref: StatusPerspectiveRef | None, maximum_reads: int, error: Callable[[bool], Exception]) -> None: ...
    @property
    def basis(self) -> WorldBasis: ...
    @property
    def perspective_ref(self) -> StatusPerspectiveRef | None: ...
    @property
    def reads_used(self) -> int: ...
    def state_of(self, resource: ResourceKey) -> ResourceStateView | None: ...
    def iter_states(self, layers: frozenset[str] | None = None, kinds: frozenset[str] | None = None, limit: int | None = None) -> Iterable[ResourceStateView]: ...
    def related(self, resource: ResourceKey, direction: RelationDirection = ..., relation_types: frozenset[str] | None = None, limit: int | None = None) -> Iterable[RelationshipView]: ...
    def iter_relationships(self, relation_types: frozenset[str] | None = None, layers: frozenset[str] | None = None, limit: int | None = None) -> Iterable[RelationshipView]: ...
