import threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from typing import Any, Final

__all__ = ['DEFAULT_HOST', 'DEFAULT_PORT', 'MAX_REQUEST_BYTES', 'WEB_ROOT', 'ScenarioRequestError', 'load_document', 'new_document', 'validate_document', 'preview_document', 'require_loopback_bind', 'ScenarioEditorServer', 'ScenarioEditorHandler', 'create_server', 'serve']

DEFAULT_HOST: str
DEFAULT_PORT: int
MAX_REQUEST_BYTES: Final[int]
WEB_ROOT: Final[Path]

class ScenarioRequestError(ValueError): ...

def load_document(path: Path | str) -> Any: ...
def new_document() -> Any: ...
def validate_document(document: Any) -> dict[str, Any]: ...
def preview_document(document: Any, *, at_time_ns: int | str | None = None) -> dict[str, Any]: ...
def require_loopback_bind(host: str) -> None: ...

class ScenarioEditorServer(ThreadingHTTPServer):
    daemon_threads: bool
    allow_reuse_address: bool
    address_family: int
    web_root: Path
    def __init__(self, server_address: tuple[str, int], *, web_root: Path = ...) -> None: ...

class ScenarioEditorHandler(BaseHTTPRequestHandler):
    server: ScenarioEditorServer
    protocol_version: str
    def setup(self) -> None: ...
    def log_message(self, format: str, *args: Any) -> None: ...
    def do_HEAD(self) -> None: ...
    def do_GET(self) -> None: ...
    close_connection: bool
    def do_POST(self) -> None: ...

def create_server(host: str = ..., port: int = ..., *, web_root: Path = ...) -> ScenarioEditorServer: ...
def serve(host: str = ..., port: int = ..., *, web_root: Path = ..., ready: threading.Event | None = None) -> None: ...
